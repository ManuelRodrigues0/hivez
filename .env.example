VITE_FIREBASE_VAPID_KEY=BDLoFeBn9Tm7ktHDZ9cm_gCv_h-Dbx_uxt4cTMU4CWNwamdVcwUQYtR-9mWfc_wSoNetcHzMTfoFV_3ZVIxHUY0

# Server-side AI verification keys. Do not expose these with a VITE_ prefix.
GEMINI_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Ultra Bee AI chat assistant (server-side only).
# Dedicated OpenRouter key for Ultra Bee - completely separate from the
# verification system's OPENROUTER_API_KEY / OPENROUTER_API_KEY2..4 (do not
# reuse the verification key here, and verification never reads this one).
ULTRA_BEE_OPENROUTER_API_KEY=
# Ultra Bee model (OpenRouter model id). Only Ultra Bee reads this variable.
OPENROUTER_MODEL=openrouter/free

# Verification pipeline - NEW dedicated provider keys (server-side only).
# Used ONLY by the report/post verification providers below.
# Groq Qwen 3.6 27B verifier (dedicated key; do not reuse any existing Groq key)
GROQ_QWEN_36_API_KEY=
# Groq Qwen 3.8 27B verifier (separate dedicated key; do not reuse the 3.6 key)
GROQ_QWEN_38_API_KEY=
# OpenRouter Free verifier (dedicated key; do not reuse OPENROUTER_API_KEY* or the Ultra Bee key)
VERIFICATION_OPENROUTER_API_KEY=

# Optional server-side verification controls.
GEMINI_MODEL=gemini-3-flash-preview
XAI_MODEL=grok-4.6
NVIDIA_NEMOTRON_NANO_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NEMOTRON_ULTRA_ENABLED=true
NVIDIA_NEMOTRON_ULTRA_VISION_ENABLED=false
OPENROUTER_GEMMA_VISION_ENABLED=false
STORE_PROVIDER_RAW_RESPONSES=false

# OmniRoute - self-hosted AI router with an OpenAI-compatible API (server-side only).
# Single centralized client: lib/omniroute/client.ts. Test endpoint: GET /api/omniroute-status.
# Switching to a remote host later only requires changing OMNIROUTE_BASE_URL.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Server-side secret for the OmniRoute instance. Never expose it with a VITE_
# prefix, in browser code, or in API responses/logs.
OMNIROUTE_API_KEY=
# Default model. "auto" lets OmniRoute itself route to a provider; Hivez never
# hardcodes a provider or model.
OMNIROUTE_MODEL=auto
